## Benchmark suite for the sqlite package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "../src/lib.alya" as sqlite

function main()
    let runner = bench_runner("SQLite3 Performance Benchmarks")

    let db = sqlite::open_memory()
    sqlite::execute(db, "CREATE TABLE bench_records (id INTEGER PRIMARY KEY, name TEXT, val INTEGER);")

    # 1. Batch Insert Benchmark
    let count = 5000
    bench_start(runner, count)
    sqlite::execute(db, "BEGIN TRANSACTION;")
    let i = 0
    while i < count
        let sql = "INSERT INTO bench_records (name, val) VALUES ('Item', {i});"
        sqlite::execute(db, sql)
        i += 1
    end
    sqlite::execute(db, "COMMIT;")
    bench_stop(runner, "5,000 In-Memory Transactional Inserts")

    # 2. Select All Query Benchmark
    bench_start(runner, 100)
    let k = 0
    while k < 100
        let rows = sqlite::query(db, "SELECT id, name, val FROM bench_records WHERE val < 500;")
        k += 1
    end
    bench_stop(runner, "100x Query (500 rows each)")

    sqlite::close(db)
    bench_summary(runner)
end

main()
