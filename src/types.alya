# Types and data structures for sqlite
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# SQLite return codes
pub enum SqliteCode
    Ok = 0
    Error = 1
    Row = 100
    Done = 101
end

# SQLite column data types
pub enum SqliteType
    Integer = 1
    Float = 2
    Text = 3
    Blob = 4
    Null = 5
end

# Backward-compatible constants
pub const SQLITE_OK = SqliteCode.Ok
pub const SQLITE_ERROR = SqliteCode.Error
pub const SQLITE_ROW = SqliteCode.Row
pub const SQLITE_DONE = SqliteCode.Done

pub const SQLITE_INTEGER = SqliteType.Integer
pub const SQLITE_FLOAT = SqliteType.Float
pub const SQLITE_TEXT = SqliteType.Text
pub const SQLITE_BLOB = SqliteType.Blob
pub const SQLITE_NULL = SqliteType.Null

pub struct Database
    handle
    path
    is_open
end

pub struct Statement
    db_handle
    stmt_handle
    sql
    is_finalized
end
