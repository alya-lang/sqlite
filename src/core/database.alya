## # sqlite/core/database
##
## Core SQLite database engine.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Manages connection lifecycle, statement preparation, typed row decoding,
## scalar queries, and existence checks over the native FFI layer.

import "std/mem"
import "../ffi.alya"
import "../types.alya"

## Opens a file-backed database, throwing a descriptive error on failure.
##
## ### Parameters
## - `path`: Database file path string.
##
## ### Returns
## An open `Database` handle.
##
## ### Examples
## ```alya
## let db = db_open("products.db")
## ```
pub function db_open(path: string) -> Database
    let p_handle = alloc(8)
    let rc = sqlite3_open(path, p_handle)
    if rc != 0
        let err_msg = f"Failed to open SQLite database: {path}"
        free(p_handle)
        throw err_msg
    end

    let handle = peek_int(p_handle, 0)
    free(p_handle)

    return Database { handle: handle, path: path, is_open: true }
end

## Opens a transient in-memory database.
##
## ### Returns
## An open `Database` handle backed by `":memory:"`.
##
## ### Examples
## ```alya
## let db = db_open_memory()
## ```
pub function db_open_memory() -> Database
    return db_open(":memory:")
end

## Closes a database connection; closing twice safely returns `0`.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## Native close result code integer.
pub function db_close(db: Database) -> int
    if db.is_open != true
        return 0
    end
    let rc = sqlite3_close(db.handle)
    db.is_open = false
    return rc
end

## Returns the most recent engine error message for a connection.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## The engine error string, or `"Database is closed"` when shut.
pub function db_error(db: Database) -> string
    if db.is_open != true
        return "Database is closed"
    end
    return sqlite3_errmsg(db.handle)
end

## Executes a SQL statement, returning the affected row count.
##
## Throws a descriptive error naming the statement on engine failure.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `sql`: SQL statement string.
##
## ### Returns
## Affected row count integer.
##
## ### Examples
## ```alya
## db_execute(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);")
## ```
pub function db_execute(db: Database, sql: string) -> int
    if db.is_open != true
        throw "Cannot execute query on closed database"
    end

    let rc = sqlite3_exec(db.handle, sql, 0, 0, 0)
    if rc != 0
        let engine_msg = sqlite3_errmsg(db.handle)
        let err = f"SQLite error in '{sql}': {engine_msg}"
        throw err
    end

    return sqlite3_changes(db.handle)
end

## Returns the row id of the most recent successful insert.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## Last insert row id integer (`0` when closed).
pub function db_last_insert_rowid(db: Database) -> int
    if db.is_open != true
        return 0
    end
    return sqlite3_last_insert_rowid(db.handle)
end

## Returns the number of rows modified by the most recent statement.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## Changed row count integer (`0` when closed).
pub function db_changes(db: Database) -> int
    if db.is_open != true
        return 0
    end
    return sqlite3_changes(db.handle)
end

## Binds every `?` placeholder of a prepared statement in order.
##
## Dispatches on the explicit `DbParam.kind` tag (never on the dynamic
## value type) and throws on count mismatch, unknown kinds, or a
## non-zero native bind result. Blob buffers use SQLITE_TRANSIENT, so
## they are freed before returning.
##
## ### Parameters
## - `stmt`: Native `sqlite3_stmt*` pointer value.
## - `params`: Array of `DbParam` (one per `?`, 1-based in order).
function bind_params(stmt, params)
    let expected = sqlite3_bind_parameter_count(stmt)
    let given = len(params)
    if expected != given
        throw f"Parameter count mismatch: statement expects {expected} placeholder(s) but got {given}"
    end
    let i = 0
    while i < given
        let p = params[i]
        let idx = i + 1
        let rc = 0
        when p.kind
            is ParamKind.Int, 1 then
                rc = sqlite3_bind_int64(stmt, idx, p.ival)
            is ParamKind.Float, 2 then
                # Bound as round-trip text from the construction-cached `sval`:
                # native `bind_double` demonstrably stores garbage for
                # mistagged dynamics on Windows ARM64 (see CI), while the
                # text path is green on all six legs. REAL-affinity columns
                # convert back losslessly.
                rc = sqlite3_bind_text(stmt, idx, p.sval, -1, -1)
            is ParamKind.Text, 3 then
                rc = sqlite3_bind_text(stmt, idx, p.sval, -1, -1)
            is ParamKind.Null, 4 then
                rc = sqlite3_bind_null(stmt, idx)
            is ParamKind.Blob, 5 then
                let raw = p.bval
                let n = len(raw)
                if n == 0
                    let empty = alloc(1)
                    rc = sqlite3_bind_blob(stmt, idx, empty, 0, -1)
                    free(empty)
                else
                    let buf = alloc(n)
                    if buf == 0
                        throw f"Out of memory binding blob parameter {idx}"
                    end
                    let j = 0
                    while j < n
                        poke_byte(buf, j, bit_and(raw[j], 255))
                        j += 1
                    end
                    rc = sqlite3_bind_blob(stmt, idx, buf, n, -1)
                    free(buf)
                end
            else
                throw f"Unknown parameter kind for placeholder {idx}; use param_int/param_float/param_text/param_null/param_blob"
        end
        if rc != 0
            throw f"Failed to bind parameter {idx}"
        end
        i += 1
    end
end

# FFI `-> str` returns a raw C pointer, and `str_clone` alone passes it
# through untouched. `str_from_ptr` dereferences it into a string and the
# outer `str_clone` heap-copies it so the value survives stepping and
# finalization (column memory is transient).
function col_text(stmt, idx) -> string
    return str_clone(str_from_ptr(sqlite3_column_text(stmt, idx)))
end

function col_name(stmt, idx) -> string
    return str_clone(str_from_ptr(sqlite3_column_name(stmt, idx)))
end

## Steps a prepared statement to completion, decoding every row.
##
## Column decoding follows the native `sqlite3_column_type` (not the
## dynamic value type): INTEGER via 64-bit reads, FLOAT as the engine's
## round-trip text, NULL as `null`, BLOB as byte arrays, TEXT as heap
## strings. Throws when the terminal step code is not `SQLITE_DONE`.
##
## ### Parameters
## - `stmt`: Native `sqlite3_stmt*` pointer value.
## - `db_handle`: Owning native `sqlite3*` pointer for error messages.
##
## ### Returns
## Array of row maps (possibly empty).
function stmt_collect(stmt, db_handle) -> array
    let col_count = sqlite3_column_count(stmt)
    let col_names = []
    let c = 0
    while c < col_count
        push(col_names, col_name(stmt, c))
        c += 1
    end

    let rows = []

    # SQLITE_ROW = 100, SQLITE_DONE = 101
    let rc_step = sqlite3_step(stmt)
    while rc_step == 100
        let row = map()
        let idx = 0
        while idx < col_count
            let col_type = sqlite3_column_type(stmt, idx)
            let key = col_names[idx]

            # INTEGER arrives as native int; FLOAT as the engine's
            # round-trip text (dynamic map slots cannot retain float tags,
            # so native doubles would read back as int bits).
            when col_type
                is SqliteType.Integer, 1 then
                    row[key] = sqlite3_column_int64(stmt, idx)
                is SqliteType.Null, 5 then
                    row[key] = null
                is SqliteType.Blob, 4 then
                    let blob_ptr = sqlite3_column_blob(stmt, idx)
                    let blob_len = sqlite3_column_bytes(stmt, idx)
                    let bytes = []
                    let b = 0
                    while b < blob_len
                        push(bytes, peek_byte(blob_ptr, b))
                        b += 1
                    end
                    row[key] = bytes
                else
                    row[key] = col_text(stmt, idx)
            end

            idx += 1
        end
        push(rows, row)
        rc_step = sqlite3_step(stmt)
    end

    if rc_step != 101
        let engine_msg = sqlite3_errmsg(db_handle)
        throw f"SQLite step failed: {engine_msg}"
    end
    return rows
end

## Runs a SELECT query, decoding every row into a column-name map.
##
## Integer, float, null, blob, and text columns map to native integers,
## round-trip text, nulls, byte arrays, and strings respectively.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `sql`: SELECT statement string.
##
## ### Returns
## Array of row maps (possibly empty).
##
## ### Examples
## ```alya
## let rows = db_query(db, "SELECT id, name FROM users ORDER BY id;")
## ```
pub function db_query(db: Database, sql: string) -> array
    if db.is_open != true
        throw "Cannot query closed database"
    end

    let p_stmt = alloc(8)
    let rc_prep = sqlite3_prepare_v2(db.handle, sql, -1, p_stmt, 0)
    if rc_prep != 0
        let engine_msg = sqlite3_errmsg(db.handle)
        let err = f"Failed to prepare query '{sql}': {engine_msg}"
        free(p_stmt)
        throw err
    end

    let stmt = peek_int(p_stmt, 0)
    free(p_stmt)

    let rows = []
    try
        rows = stmt_collect(stmt, db.handle)
    finally
        sqlite3_finalize(stmt)
    end
    return rows
end

## Returns the first column of the first row, or null when no rows match.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `sql`: SELECT statement string.
##
## ### Returns
## The scalar value, or null for empty results.
##
## ### Examples
## ```alya
## let total = db_query_scalar(db, "SELECT count(*) FROM users;")
## ```
pub function db_query_scalar(db: Database, sql: string)
    let rows = db_query(db, sql)
    if len(rows) == 0
        return null
    end
    let first_row = rows[0]
    let ks = keys(first_row)
    for k in ks
        return first_row[k]
    end
    return null
end

## Executes a DML/DDL statement with bound `?` parameters.
##
## Values are bound from explicitly-typed `DbParam` entries (see
## `param_int`, `param_float`, `param_text`, `param_null`, `param_blob`),
## so text with quotes needs no escaping. Handles a single statement;
## use `db_execute` for multi-statement scripts.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `sql`: SQL statement with `?` placeholders.
## - `params`: Array of `DbParam`, one per placeholder in order.
##
## ### Returns
## Affected row count integer.
##
## ### Examples
## ```alya
## db_execute_params(db, "INSERT INTO users (name, score) VALUES (?, ?);", [param_text("O'Brien"), param_float(95.5)])
## ```
pub function db_execute_params(db: Database, sql: string, params: array) -> int
    if db.is_open != true
        throw "Cannot execute query on closed database"
    end

    let p_stmt = alloc(8)
    let rc_prep = sqlite3_prepare_v2(db.handle, sql, -1, p_stmt, 0)
    if rc_prep != 0
        let engine_msg = sqlite3_errmsg(db.handle)
        let err = f"Failed to prepare query '{sql}': {engine_msg}"
        free(p_stmt)
        throw err
    end

    let stmt = peek_int(p_stmt, 0)
    free(p_stmt)

    let affected = 0
    try
        bind_params(stmt, params)
        # SQLITE_ROW = 100, SQLITE_DONE = 101
        let rc_step = sqlite3_step(stmt)
        while rc_step == 100
            rc_step = sqlite3_step(stmt)
        end
        if rc_step != 101
            let engine_msg = sqlite3_errmsg(db.handle)
            throw f"SQLite step failed for '{sql}': {engine_msg}"
        end
        affected = sqlite3_changes(db.handle)
    finally
        sqlite3_finalize(stmt)
    end
    return affected
end

## Runs a SELECT query with bound `?` parameters.
##
## Decoding matches `db_query`; placeholders are bound from `DbParam`
## entries in order.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `DbParam`, one per placeholder in order.
##
## ### Returns
## Array of row maps (possibly empty).
##
## ### Examples
## ```alya
## let rows = db_query_params(db, "SELECT id FROM users WHERE name = ?;", [param_text("Alice")])
## ```
pub function db_query_params(db: Database, sql: string, params: array) -> array
    if db.is_open != true
        throw "Cannot query closed database"
    end

    let p_stmt = alloc(8)
    let rc_prep = sqlite3_prepare_v2(db.handle, sql, -1, p_stmt, 0)
    if rc_prep != 0
        let engine_msg = sqlite3_errmsg(db.handle)
        let err = f"Failed to prepare query '{sql}': {engine_msg}"
        free(p_stmt)
        throw err
    end

    let stmt = peek_int(p_stmt, 0)
    free(p_stmt)

    let rows = []
    try
        bind_params(stmt, params)
        rows = stmt_collect(stmt, db.handle)
    finally
        sqlite3_finalize(stmt)
    end
    return rows
end

## Returns the first column of the first row for a parameterized query.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `DbParam`, one per placeholder in order.
##
## ### Returns
## The scalar value, or null for empty results.
pub function db_query_scalar_params(db: Database, sql: string, params: array)
    let rows = db_query_params(db, sql, params)
    if len(rows) == 0
        return null
    end
    let first_row = rows[0]
    let ks = keys(first_row)
    for k in ks
        return first_row[k]
    end
    return null
end

## Checks whether a table exists in the database schema.
##
## The name is bound as a parameter, never interpolated, so quoted or
## hostile names cannot escape the lookup query.
##
## ### Parameters
## - `db`: Target `Database` handle.
## - `table_name`: Table name string.
##
## ### Returns
## `1` when the table exists, `0` otherwise.
pub function db_table_exists(db: Database, table_name: string) -> int
    let cnt = db_query_scalar_params(db, "SELECT count(*) FROM sqlite_master WHERE type='table' AND name=?;", [param_text(table_name)])
    return when
        cnt is not null and cnt > 0 => true
        else                        => false
    end
end

## Begins a transaction.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## Affected row count integer.
pub function db_begin(db: Database) -> int
    return db_execute(db, "BEGIN;")
end

## Commits the current transaction.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## Affected row count integer.
pub function db_commit(db: Database) -> int
    return db_execute(db, "COMMIT;")
end

## Rolls back the current transaction.
##
## ### Parameters
## - `db`: Target `Database` handle.
##
## ### Returns
## Affected row count integer.
pub function db_rollback(db: Database) -> int
    return db_execute(db, "ROLLBACK;")
end
