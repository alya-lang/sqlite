## Demonstration of the sqlite package
##
## Opens file-based and in-memory databases and exercises version info,
## CRUD operations, scalar queries, and relational JOINs.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as sqlite
import "std/fs"

@cfg(feature = "lifecycle")
function demo_lifecycle()
    say "-------------------------------------------"
    let engine_ver = sqlite::version()
    let engine_src = sqlite::source_id()
    say f"SQLite Engine Version: {engine_ver}"
    say f"Source ID:             {engine_src}"

    let mem = sqlite::open_memory()
    say "In-memory database opened."
    sqlite::close(mem)
    say "In-memory database closed."
    say "-------------------------------------------"
end

@cfg(not(feature = "lifecycle"))
function demo_lifecycle()
end

# File CRUD needs `write` on a `lifecycle` handle; self-contained so it
# also runs when `read` is off (cleans up its own db file).
@cfg(feature = "write")
@cfg(feature = "lifecycle")
function demo_write()
    say "--- Write: file database CRUD ---"
    let db_file = "products.db"
    if fs_exists(db_file)
        remove_file(db_file)
    end

    let db = sqlite::open(db_file)
    say f"1. Database opened: {db_file}"

    sqlite::execute(db, "CREATE TABLE categories (id INTEGER PRIMARY KEY, title TEXT);")
    sqlite::execute(db, "CREATE TABLE products (id INTEGER PRIMARY KEY, category_id INTEGER, name TEXT, price REAL, stock INTEGER);")
    say "2. Tables created: categories, products"

    sqlite::execute(db, "INSERT INTO categories (title) VALUES ('Electronics');")
    let cat_id = sqlite::last_insert_id(db)
    say f"3. Category id: {cat_id}"
    sqlite::execute(db, f"INSERT INTO products (category_id, name, price, stock) VALUES ({cat_id}, 'Laptop Pro 16', 2499.99, 12);")
    sqlite::execute(db, f"INSERT INTO products (category_id, name, price, stock) VALUES ({cat_id}, 'Mechanical Keyboard', 149.50, 45);")
    say "4. Data inserted successfully!"

    sqlite::close(db)
    say "5. Database closed."
    remove_file(db_file)
end

# Read showcase populates via `write`, so it needs the trio. Row maps
# are read directly (row_* helpers belong to `row_helpers`).
@cfg(feature = "read")
@cfg(feature = "write")
@cfg(feature = "lifecycle")
function demo_read()
    say "--- Read: scalar queries and JOINs ---"
    let db_file = "products.db"
    if fs_exists(db_file)
        remove_file(db_file)
    end

    let db = sqlite::open(db_file)
    sqlite::execute(db, "CREATE TABLE categories (id INTEGER PRIMARY KEY, title TEXT);")
    sqlite::execute(db, "CREATE TABLE products (id INTEGER PRIMARY KEY, category_id INTEGER, name TEXT, price REAL, stock INTEGER);")
    sqlite::execute(db, "INSERT INTO categories (title) VALUES ('Electronics');")
    let cat_id = sqlite::last_insert_id(db)
    sqlite::execute(db, "INSERT INTO categories (title) VALUES ('Books');")
    sqlite::execute(db, f"INSERT INTO products (category_id, name, price, stock) VALUES ({cat_id}, 'Laptop Pro 16', 2499.99, 12);")
    sqlite::execute(db, f"INSERT INTO products (category_id, name, price, stock) VALUES ({cat_id}, 'Mechanical Keyboard', 149.50, 45);")
    sqlite::execute(db, f"INSERT INTO products (category_id, name, price, stock) VALUES ({cat_id}, 'Wireless Mouse', 49.99, 110);")
    sqlite::execute(db, "INSERT INTO products (category_id, name, price, stock) VALUES (2, 'Compilers: Principles & Techniques', 89.00, 20);")

    let total_prods = sqlite::query_scalar(db, "SELECT count(*) FROM products;")
    say f"Total product count: {total_prods}"

    say "Running SQL JOIN Query (Products + Categories):"
    let sql_join = "SELECT p.id, p.name, c.title as category, p.price, p.stock FROM products p JOIN categories c ON p.category_id = c.id ORDER BY p.price DESC;"
    let rows = sqlite::query(db, sql_join)
    for r in rows
        let pid = r["id"]
        let pname = r["name"]
        let cat = r["category"]
        let price = r["price"]
        let stock = r["stock"]
        say f"   [{pid}] {pname} ({cat}) - ${price} | Stock: {stock}"
    end

    sqlite::close(db)
    remove_file(db_file)
end

@cfg(feature = "row_helpers")
function demo_row_helpers()
    # Row helpers operate on plain maps, so this slice is self-contained.
    # Values are extracted to locals first: nested double quotes do not
    # parse inside `{...}` interpolations. `row_float` demos int promotion
    # (float literals hit a compiler narrowing quirk after `is null`).
    say "--- Row helpers: typed column extraction ---"
    let row = { "id": 7, "name": "Wireless Mouse", "stock": 110, "note": null }
    let show_id = sqlite::row_int(row, "id")
    let show_name = sqlite::row_str(row, "name")
    let show_stock = sqlite::row_float(row, "stock")
    let show_note = sqlite::row_str(row, "note")
    say f"id as int:      {show_id}"
    say f"name as text:   {show_name}"
    say f"stock as float: {show_stock}"
    say f"null as text:   '{show_note}'"
end

@cfg(not(feature = "row_helpers"))
function demo_row_helpers()
end

function main()
    say "==========================================="
    say "       ALYA SQLITE3 DEMO (C FFI ENGINE)    "
    say "==========================================="

    demo_lifecycle()
    @cfg(feature = "write")
    @cfg(feature = "lifecycle")
    demo_write()
    @cfg(feature = "read")
    @cfg(feature = "write")
    @cfg(feature = "lifecycle")
    demo_read()
    demo_row_helpers()

    say "==========================================="
end

main()
